# Testing and coverage
coverage/
.nyc_output/

# Temporary files
*.tmp
*.swp
next-env.d.ts

# TypeScript incremental build cache
tsconfig.tsbuildinfo

# Local scratch（截图、工具输出，不进版本库）
.tmp/
.pnpm-store/
