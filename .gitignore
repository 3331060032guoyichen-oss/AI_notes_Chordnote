# Dependencies
node_modules/
.pnp/
.pnp.js

# Next.js
.next/
out/

# Production
build/
dist/

# Local environment (all real env files, whatever the suffix)
.env*
!.env.example

# 本地知识库（PGlite 数据目录 + 导出备份）——每个使用者的数据都在自己机器上，不进版本库
data/*
!data/.gitkeep

# Logs
*.log
logs/

# OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
