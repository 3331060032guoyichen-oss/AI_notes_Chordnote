{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chordnote",
  "version": "0.2.0",
  "identifier": "com.chordnote.desktop",
  "build": {
    "beforeDevCommand": "pnpm desktop:dev:server",
    "devUrl": "http://127.0.0.1:3210",
    "beforeBuildCommand": "pnpm desktop:prepare",
    "frontendDist": "placeholder"
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "Chordnote",
        "width": 1440,
        "height": 920,
        "minWidth": 390,
        "minHeight": 600,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../.desktop/runtime/": "runtime/",
      "../.desktop/demo/": "demo/"
    },
    "windows": {
      "bundleVCRuntime": true,
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
