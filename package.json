{
  "name": "ai-notes",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/next-build.mjs",
    "start": "next start",
    "lint": "eslint .",
    "test": "node scripts/regression.mjs",
    "test:unit": "node --import ./scripts/ts-resolve.mjs --test lib/ai/provider.test.ts lib/ai/config.test.ts lib/agent/permission.test.ts",
    "test:agent": "node --experimental-transform-types --import ./scripts/ts-resolve.mjs --test --test-concurrency=1 lib/agent/context.test.ts lib/agent/runtime.test.ts lib/services/agent-context.test.ts",
    "test:vault": "node --experimental-transform-types --import ./scripts/ts-resolve.mjs --test lib/vault/vault.test.ts lib/vault/watcher.test.ts",
    "verify:db": "node scripts/db-verify.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "seed:reset": "node scripts/reset-demo-data.mjs",
    "desktop:dev:server": "next dev --hostname 127.0.0.1 --port 3210",
    "desktop:dev": "pnpm desktop:prepare && tauri dev",
    "desktop:prepare": "node scripts/create-tauri-icon.mjs && pnpm build && node scripts/prepare-desktop.mjs",
    "desktop:verify:runtime": "node scripts/verify-desktop-runtime.mjs",
    "desktop:build": "tauri build --bundles nsis"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.9.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sdk-client": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sdk-protocol": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@electric-sql/pglite": "^0.5.10",
    "@lezer/common": "^1.5.3",
    "@lezer/markdown": "^1.8.0",
    "@tsparticles/engine": "^4.4.0",
    "@tsparticles/react": "^4.4.0",
    "@tsparticles/slim": "^4.4.0",
    "chokidar": "5.0.0",
    "d3-force": "^3.0.0",
    "drizzle-orm": "0.45.4",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "0.186.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@next/eslint-plugin-next": "^15.5.26",
    "@tauri-apps/cli": "2.12.3",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.186.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.0.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "typescript": "^5.0.0"
  }
}
